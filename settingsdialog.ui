       <widget class="QComboBox" name="networkComboBox">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="styleSheet">
         <string notr="true">#networkComboBox {
    background-color: #334155;
    color: #e2e8f0;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 6px 10px;
}



#networkComboBox::drop-down { border: none; width: 18px; }
#networkComboBox::down-arrow {
    image: url(:/caret-down.svg);
    width: 10px;
    height: 10px;
}
#networkComboBox QLineEdit {
    background: transparent;
    border: none;
    color: #e2e8f0;
    padding: 2px 4px;
}
#networkComboBox QAbstractItemView {
    background-color: #1e293b;
    alternate-background-color: #1e293b;
    color: #e2e8f0;
    selection-background-color: #3b82f6;
    selection-color: #f8fafc;
    padding: 0px;
    margin: 0px;
    border: none;
    outline: none;
}
#networkComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border: none;
    background-color: #1e293b;
    color: #e2e8f0;
}
#networkComboBox QAbstractItemView::item:selected {
    background-color: #3b82f6;
    color: #f8fafc;
}
#networkComboBox QAbstractItemView::item:hover {
    background-color: #334155;
}</string>
