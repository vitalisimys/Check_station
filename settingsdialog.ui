        <property name="styleSheet">
         <string notr="true">#networkComboBox {
    background-color: #0b1220;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
}
#networkComboBox:hover { border-color: #475569; }
#networkComboBox:focus { border-color: #3b82f6; }
#networkComboBox::drop-down { border: none; width: 22px; }
#networkComboBox::down-arrow {
    image: url(:/caret-down-blue.svg);
    width: 13px;
    height: 13px;
}
#networkComboBox QLineEdit {
    background: transparent;
    border: none;
    color: #e2e8f0;
    padding: 2px 4px;
}
#networkComboBox QAbstractItemView {
    background-color: #0f172a;
    alternate-background-color: #0f172a;
    color: #e2e8f0;
    selection-background-color: #1e40af;
    selection-color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
#networkComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    background-color: #0f172a;
    color: #e2e8f0;
}
#networkComboBox QAbstractItemView::item:selected {
    background-color: #1e40af;
    color: #f8fafc;
}
#networkComboBox QAbstractItemView::item:hover {
    background-color: #1e293b;
}</string>
