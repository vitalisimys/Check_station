         </sizepolicy>
        </property>
        <property name="styleSheet">
         <string notr="true">QComboBox {
    background-color: #333333; /* Темный фон */
    color: #FFFFFF;            /* Белый текст */
    border: 1px solid #555555; /* Тонкая рамка */
    border-radius: 4px;        /* Скругленные углы */
    padding: 0px 20px;         /* Отступы внутри */
}

QComboBox:hover {
    background-color: #555555; /* Фон при наведении на нераскрывшийся список*/
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 10px;               /* Ширина кнопки выпадающего списка */
    border-left: 2px solid #555555; /* левая граница кнопки полоска */
}

QComboBox QAbstractItemView {
    background-color: #555555; /* Фон выпадающего списка */
    color: #FFFFFF;            /* Цвет текста в списке */
     border: 1px solid #555555; /* Тонкая рамка */
    selection-background-color: #111111; /* Фон выбранного элемента */
    selection-color: #FFFFFF;  /* Цвет текста выбранного элемента */
}

QComboBox::down-arrow {
    image: url(:/caret-down.svg);
    width: 12px;
    height: 12px;
    margin: 2px;
}</string>
        </property>
       </widget>
