        <item>
         <widget class="QPushButton" name="pushButtonConnectStation">
          <property name="styleSheet">
           <string notr="true">QPushButton {
    background-color: #3b82f6;         /* Синий акцент */
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
