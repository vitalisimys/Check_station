  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">#centralwidget {
    background-color: #1e293b;        /* Тёмно-синий фон */
    color: #e2e8f0;                    /* Светлый текст */
}

/* Стиль для вертикальной полосы прокрутки внутри QTextEdit */
QScrollBar:vertical {
    width: 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333333, stop:1 #1A1A1A);
    margin: 16px 0 16px 0;
}

/* Стиль для движка полосы прокрутки */
QScrollBar::handle:vertical {
    background: #1e293b;
    min-height: 20px;
    border-radius: 8px;
}

/* Стиль для движка при наведении */
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5A5A5A, stop:1 #444444);
}

/* Стиль для кнопки &quot;вниз&quot; */
QScrollBar::add-line:vertical {
    height: 16px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(:/caret-down.svg);
}

/* Стиль для кнопки &quot;вверх&quot; */
QScrollBar::sub-line:vertical {
    height: 16px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(:/caret-up.svg);
}

/* Стиль для фона между движком и кнопками */
QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}

QProgressBar {
    border: 1px solid #334155;
    border-radius: 6px;
    background-color: #0f172a;
    min-height: 10px;
    max-height: 14px;
    color: #e2e8f0;
    font-size: 9pt;
}
QProgressBar::chunk {
    border-radius: 5px;
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2563eb,
        stop:1 #3b82f6
    );
}

QProgressBar:indeterminate {
    background-color: #1e293b;
}</string>
   </property>
