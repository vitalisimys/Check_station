                 </property>
                 <property name="styleSheet">
                  <string notr="true">#horizontalSliderBW {
    min-height: 28px;
}
#horizontalSliderBW::groove:horizontal {
    height: 6px;
    background: #0b1220;
    border-radius: 3px;
    border: 1px solid #1f2a44;
}
#horizontalSliderBW::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #38bdf8);
    border-radius: 3px;
}
#horizontalSliderBW::add-page:horizontal {
    background: #1f2a44;
    border-radius: 3px;
}
#horizontalSliderBW::handle:horizontal {
    background: #3b82f6;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
    border: 2px solid #93c5fd;
}
#horizontalSliderBW::handle:horizontal:hover {
    background: #60a5fa;
    border-color: #bfdbfe;
}
#horizontalSliderBW::handle:horizontal:pressed {
    background: #2563eb;
}
#horizontalSliderBW::tick-mark:horizontal {
    background: #475569;
}</string>
                 </property>
                 <property name="minimum">
