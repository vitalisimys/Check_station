         <string notr="true">QPushButton {
    background-color: #64748b;
    color: #e2e8f0;
    border: 1px solid #64748b;
    padding: 4px 8px;
    border-radius: 0px;
    font-weight: bold;
    min-width: 80px;
}
QPushButton:hover { background-color: #708197; border-color: #708197; }
QPushButton:pressed { background-color: #55657b; border-color: #55657b; }
QPushButton:disabled { background-color: #64748b; color: #94a3b8; border: 1px solid #64748b; }</string>
