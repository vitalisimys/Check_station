         </size>
        </property>
        <property name="styleSheet">
         <string notr="true">/*#logTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #333333, stop:1 #1A1A1A); /* Вертикальный градиент 
    border: 1px solid #555555; /* Тонкая рамка 
    border-radius: 8px;        /* Закругленные углы 
}*/

#logTextEdit {
    background-color: #0f172a;
    color: #10b981;
    font-family: &quot;Consolas&quot;;
}

/* Стиль для вертикальной полосы прокрутки внутри QTextEdit */
QScrollBar:vertical {
    width: 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333333, stop:1 #1A1A1A);
    margin: 16px 0 16px 0;
}

/* Стиль для движка полосы прокрутки */
QScrollBar::handle:vertical {
    background: #1e293b;
    min-height: 20px;
    border-radius: 8px;
}

/* Стиль для движка при наведении */
QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5A5A5A, stop:1 #444444);
}

/* Стиль для кнопки &quot;вниз&quot; */
QScrollBar::add-line:vertical {
    height: 16px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(:/caret-down.svg);
}

/* Стиль для кнопки &quot;вверх&quot; */
QScrollBar::sub-line:vertical {
    height: 16px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(:/caret-up.svg);
}

/* Стиль для фона между движком и кнопками */
QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}</string>
        </property>
        <property name="sizeAdjustPolicy">
         <enum>QAbstractScrollArea::AdjustIgnored</enum>
        </property>
        <property name="readOnly">
         <bool>true</bool>
        </property>
       </widget>
